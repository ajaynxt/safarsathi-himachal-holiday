# ========================================================
# AJAYNXT Social Analytics - Environment Configuration
# ========================================================

# General Configuration
NODE_ENV=development
PORT=8080
GCP_REGION=asia-south1

# Meta / Instagram Graph API Settings
META_API_VERSION=v21.0
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://app.ajaynxt.com/api/instagram/callback

# Security & Master Encryption Key
# 32-byte hexadecimal string (64 characters) used for AES-256-GCM token encryption
# In production, this key must be fetched from Google Cloud Secret Manager
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Firebase & Google Cloud Project
FIREBASE_PROJECT_ID=ajaynxt-social-analytics
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ajaynxt-social-analytics.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Client CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.ajaynxt.com
