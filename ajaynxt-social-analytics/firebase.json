{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "AJAYNXT Social Analytics",
        "supportEmail": "ajayx3neha@gmail.com",
        "authorizedRedirectUris": [
          "https://ajaynxt-ai-design-studio.firebaseapp.com/__/auth/handler",
          "https://ajaynxt-ai-design-studio.web.app",
          "http://localhost:3000",
          "http://localhost:5173"
        ]
      }
    }
  },
  "hosting": {
    "site": "ajaynxt-ai-design-studio",
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
